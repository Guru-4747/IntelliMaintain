{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IntelliMaintain: Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "IntelliMaintain: diagnose demo sample",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/diagnose.py",
      "args": ["data/samples/outer_race_007_3hp.csv"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "IntelliMaintain: full setup",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/setup_all.py",
      "cwd": "${workspaceFolder}"
    }
  ]
}
