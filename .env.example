# Copy this file to .env and fill it in. .env is git-ignored - never commit API keys.
# Online (Streamlit Community Cloud) put the same keys in the app's Settings -> Secrets instead.

# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# IM_LLM_MODEL=gemini-3.5-flash-lite      # or gemini-3.8-flash for richer answers
# IM_LLM_RPM=8                            # requests per minute (stay under the free-tier limit)
# IM_LLM_PROVIDER=offline                 # force the no-LLM mode
# IM_WEB_SEARCH=auto                      # online evidence from Wikipedia: off | auto | always

# Retrieval models (Hugging Face names). Set IM_RERANK_MODEL=none to save memory on small servers.
IM_EMBED_MODEL=BAAI/bge-small-en-v1.5
IM_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
